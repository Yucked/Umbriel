# Generated by Cargo
# will have compiled files and executables
/target/
target
# Standalone test fixtures resolve their own lockfiles at test time.
crates/tests/fixtures/*/Cargo.lock
# trybuild's output for cases whose diagnostics differ from their `.stderr`.
crates/tests/wip/

# These are backup files generated by rustfmt
**/*.rs.bk

node_modules

# Yarn: https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored
# https://yarnpkg.com/getting-started/qa#how-to-share-scripts-between-workspaces
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions


.vscode

# Untracked while they are rewritten.
/docs/
graphify-out/*